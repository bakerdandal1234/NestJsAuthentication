# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=my_app_db

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Mail (Gmail SMTP) ---
# 1. Enable 2-Step Verification on the Gmail account:
#    https://myaccount.google.com/security
# 2. Generate an App Password (16 characters):
#    https://myaccount.google.com/apppasswords
# 3. Use that App Password below — NOT your normal Gmail password.
# MAIL_FROM should use the same address as MAIL_USER; Gmail overrides/rejects
# a "From" address that doesn't match the authenticated account.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM="My App <your-gmail-address@gmail.com>"

# --- OAuth: Google ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# --- OAuth: GitHub ---
# https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/v1/auth/github/callback

# --- Cookies / CSRF ---
# SameSite policy for the refresh_token/csrf_token cookies (both scoped to
# /v1/auth). Leave unset to use the built-in default: 'none' in production
# (needed when the frontend is on a different registrable domain than the
# API), 'lax' otherwise.
COOKIE_SAME_SITE=lax
# Only needed when the API and frontend share a parent domain across
# subdomains (e.g. api.example.com / app.example.com -> .example.com).
# Leave unset for local development.
COOKIE_DOMAIN=
# HMAC key the server uses to deterministically derive the CSRF token as
# HMAC-SHA256(sessionId, CSRF_SECRET) - no DB storage/lookup involved.
# Generate with: openssl rand -base64 64
CSRF_SECRET=replace-with-a-long-random-secret
# Signing key for the short-lived (60s), single-purpose OAuth exchange code
# returned by the /auth/google/callback and /auth/github/callback redirect.
# Generate with: openssl rand -base64 64
OAUTH_CODE_SECRET=replace-with-a-different-long-random-secret
